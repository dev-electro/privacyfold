{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://privacyfold.com/schemas/pdf_split.json",
  "title": "Split PDF",
  "description": "Pull page ranges out of a PDF into new files.",
  "x-privacyfold-tool-id": "pdf_split",
  "x-privacyfold-category": "pdf",
  "x-privacyfold-standard": "ISO 32000-1 (PDF 1.7) via pdf-lib",
  "x-privacyfold-engine": "none (plain JavaScript in the browser tab)",
  "x-privacyfold-accepts": "pdf",
  "x-privacyfold-execution-url": "https://privacyfold.com/tools/pdf-split/?mode=agent#payload",
  "type": "object",
  "properties": {
    "preset": {
      "type": "string",
      "enum": [
        "default"
      ]
    },
    "input": {
      "type": "string",
      "description": "A PDF file (data URI or pasted File) processed in the tab; never uploaded."
    },
    "options": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "input"
  ]
}
