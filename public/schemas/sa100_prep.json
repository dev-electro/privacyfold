{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://privacyfold.com/schemas/sa100_prep.json",
  "title": "SA100 helper",
  "description": "Line up Self Assessment figures before you file.",
  "x-privacyfold-tool-id": "sa100_prep",
  "x-privacyfold-category": "forms",
  "x-privacyfold-standard": "ECMAScript (any modern browser)",
  "x-privacyfold-engine": "none (plain JavaScript in the browser tab)",
  "x-privacyfold-accepts": "none",
  "x-privacyfold-execution-url": "https://privacyfold.com/tools/sa100-prep/?mode=agent#payload",
  "type": "object",
  "properties": {
    "preset": {
      "type": "string",
      "enum": [
        "uk-hmrc-sa100-self-assessment"
      ]
    },
    "input": {
      "type": "string",
      "description": "A file or text value processed in the tab; never uploaded."
    },
    "options": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "input"
  ]
}
