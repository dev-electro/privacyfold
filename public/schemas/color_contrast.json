{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://privacyfold.com/schemas/color_contrast.json",
  "title": "Color palette & contrast checker",
  "description": "Check WCAG 2.1 AA and AAA accessibility contrast ratios between foreground and background colors, and convert between Hex and RGB.",
  "x-privacyfold-tool-id": "color_contrast",
  "x-privacyfold-category": "image",
  "x-privacyfold-engine": "/wasm/image/color-contrast-v1.wasm",
  "x-privacyfold-determinism-tier": "D",
  "x-privacyfold-execution-url": "https://privacyfold.com/tools/color_contrast?mode=agent&source=mcp#payload",
  "type": "object",
  "properties": {
    "preset": {
      "type": "string",
      "enum": [
        "wcag-2-2-aaa-contrast-audit"
      ]
    },
    "input": {
      "type": "string",
      "description": "Input text, data URI, or local File handle via data-pf='input'"
    },
    "options": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "input"
  ]
}