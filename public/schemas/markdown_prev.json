{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://privacyfold.com/schemas/markdown_prev.json",
  "title": "Markdown to HTML converter",
  "description": "Convert Markdown headings, lists, code blocks, and links into clean, semantic HTML markup.",
  "x-privacyfold-tool-id": "markdown_prev",
  "x-privacyfold-category": "dev",
  "x-privacyfold-engine": "/wasm/dev/markdown-prev-v1.wasm",
  "x-privacyfold-determinism-tier": "D",
  "x-privacyfold-execution-url": "https://privacyfold.com/tools/markdown_prev?mode=agent&source=mcp#payload",
  "type": "object",
  "properties": {
    "preset": {
      "type": "string",
      "enum": [
        "default"
      ]
    },
    "input": {
      "type": "string",
      "description": "Input text, data URI, or local File handle via data-pf='input'"
    },
    "options": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "input"
  ]
}