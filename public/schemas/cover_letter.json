{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://privacyfold.com/schemas/cover_letter.json",
  "title": "Cover letter generator",
  "description": "Generate a structured, concise cover letter tailored to a company and role without uploading your resume to third-party job portals.",
  "x-privacyfold-tool-id": "cover_letter",
  "x-privacyfold-category": "forms",
  "x-privacyfold-engine": "/wasm/forms/cover-letter-v1.wasm",
  "x-privacyfold-determinism-tier": "D",
  "x-privacyfold-execution-url": "https://privacyfold.com/tools/cover_letter?mode=agent&source=mcp#payload",
  "type": "object",
  "properties": {
    "preset": {
      "type": "string",
      "enum": [
        "default"
      ]
    },
    "input": {
      "type": "string",
      "description": "Input text, data URI, or local File handle via data-pf='input'"
    },
    "options": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "input"
  ]
}