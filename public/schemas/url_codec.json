{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://privacyfold.com/schemas/url_codec.json",
  "title": "URL encoder, decoder & parser",
  "description": "Decode or encode URL strings and break down query parameters, host, path, and protocol.",
  "x-privacyfold-tool-id": "url_codec",
  "x-privacyfold-category": "dev",
  "x-privacyfold-standard": "ECMAScript (any modern browser)",
  "x-privacyfold-engine": "none (plain JavaScript in the browser tab)",
  "x-privacyfold-accepts": "text",
  "x-privacyfold-execution-url": "https://privacyfold.com/tools/url-codec/?mode=agent#payload",
  "type": "object",
  "properties": {
    "preset": {
      "type": "string",
      "enum": [
        "default"
      ]
    },
    "input": {
      "type": "string",
      "description": "Text to process. Sent to the tool only through the URL fragment / local input."
    },
    "options": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "input"
  ]
}
