{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://privacyfold.com/schemas/image_upscaler.json",
  "title": "AI image upscaler & restorer",
  "description": "Upscale small or compressed photos by 2\u00d7 with edge-preserving super-resolution (Real-ESRGAN-compact / OmniSR-nano ~18 MB on WebGPU).",
  "x-privacyfold-tool-id": "image_upscaler",
  "x-privacyfold-category": "image",
  "x-privacyfold-engine": "omnisr-nano-fp16",
  "x-privacyfold-determinism-tier": "M",
  "x-privacyfold-execution-url": "https://privacyfold.com/tools/image_upscaler?mode=agent&source=mcp#payload",
  "type": "object",
  "properties": {
    "preset": {
      "type": "string",
      "enum": [
        "default"
      ]
    },
    "input": {
      "type": "string",
      "description": "Input text, data URI, or local File handle via data-pf='input'"
    },
    "options": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "input"
  ]
}