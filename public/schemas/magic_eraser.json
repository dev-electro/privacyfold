{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://privacyfold.com/schemas/magic_eraser.json",
  "title": "Object & watermark remover (Inpainting)",
  "description": "Remove unwanted objects, date stamps, or watermarks using fast-fourier convolution inpainting (LaMa-FP16-pruned ~38 MB on WebGPU) directly in your browser.",
  "x-privacyfold-tool-id": "magic_eraser",
  "x-privacyfold-category": "image",
  "x-privacyfold-engine": "lama-fp16-pruned",
  "x-privacyfold-determinism-tier": "M",
  "x-privacyfold-execution-url": "https://privacyfold.com/tools/magic_eraser?mode=agent&source=mcp#payload",
  "type": "object",
  "properties": {
    "preset": {
      "type": "string",
      "enum": [
        "default"
      ]
    },
    "input": {
      "type": "string",
      "description": "Input text, data URI, or local File handle via data-pf='input'"
    },
    "options": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "input"
  ]
}