{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://privacyfold.com/schemas/heic_to_jpg.json",
  "title": "iPhone HEIC to JPG converter",
  "description": "Open iPhone photos anywhere.",
  "x-privacyfold-tool-id": "heic_to_jpg",
  "x-privacyfold-category": "image",
  "x-privacyfold-standard": "ISO/IEC 23008-12 (HEIF) via libheif",
  "x-privacyfold-engine": "libheif WebAssembly (inlined in /vendor/libheif.js)",
  "x-privacyfold-accepts": "heic",
  "x-privacyfold-execution-url": "https://privacyfold.com/tools/heic-to-jpg/?mode=agent#payload",
  "type": "object",
  "properties": {
    "preset": {
      "type": "string",
      "enum": [
        "default"
      ]
    },
    "input": {
      "type": "string",
      "description": "A file or text value processed in the tab; never uploaded."
    },
    "options": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "input"
  ]
}
