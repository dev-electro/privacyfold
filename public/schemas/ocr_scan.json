{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://privacyfold.com/schemas/ocr_scan.json",
  "title": "Fill from scan & local OCR",
  "description": "Extract text from scanned IDs, invoices, or payslips locally in your browser and map fields to W-9 or SA100 boxes with human confirmation.",
  "x-privacyfold-tool-id": "ocr_scan",
  "x-privacyfold-category": "pdf",
  "x-privacyfold-engine": "tesseract-ppocr-v6",
  "x-privacyfold-determinism-tier": "M",
  "x-privacyfold-execution-url": "https://privacyfold.com/tools/ocr_scan?mode=agent&source=mcp#payload",
  "type": "object",
  "properties": {
    "preset": {
      "type": "string",
      "enum": [
        "us-tsa-precheck-doc"
      ]
    },
    "input": {
      "type": "string",
      "description": "Input text, data URI, or local File handle via data-pf='input'"
    },
    "options": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "input"
  ]
}