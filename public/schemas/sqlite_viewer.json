{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://privacyfold.com/schemas/sqlite_viewer.json",
  "title": "Local SQL & table query runner",
  "description": "Run relational SQL projections and filters over local CSV or JSON datasets in browser memory.",
  "x-privacyfold-tool-id": "sqlite_viewer",
  "x-privacyfold-category": "dev",
  "x-privacyfold-standard": "SQLite 3 via sql.js",
  "x-privacyfold-engine": "sql.js WebAssembly (/vendor/sql-wasm.wasm)",
  "x-privacyfold-accepts": "text",
  "x-privacyfold-execution-url": "https://privacyfold.com/tools/sqlite-viewer/?mode=agent#payload",
  "type": "object",
  "properties": {
    "preset": {
      "type": "string",
      "enum": [
        "default"
      ]
    },
    "input": {
      "type": "string",
      "description": "Text to process. Sent to the tool only through the URL fragment / local input."
    },
    "options": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "input"
  ]
}
