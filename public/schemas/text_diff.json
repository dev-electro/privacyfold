{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://privacyfold.com/schemas/text_diff.json",
  "title": "Text & code diff checker",
  "description": "Compare two versions of text, configuration or code separated by --- to see added and removed lines.",
  "x-privacyfold-tool-id": "text_diff",
  "x-privacyfold-category": "dev",
  "x-privacyfold-engine": "/wasm/dev/text-diff-v1.wasm",
  "x-privacyfold-determinism-tier": "D",
  "x-privacyfold-execution-url": "https://privacyfold.com/tools/text_diff?mode=agent&source=mcp#payload",
  "type": "object",
  "properties": {
    "preset": {
      "type": "string",
      "enum": [
        "default"
      ]
    },
    "input": {
      "type": "string",
      "description": "Input text, data URI, or local File handle via data-pf='input'"
    },
    "options": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "input"
  ]
}