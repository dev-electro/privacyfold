{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://privacyfold.com/schemas/hash_gen.json",
  "title": "Hash generator",
  "description": "Create a SHA fingerprint of text or any file, to check that it has not changed.",
  "x-privacyfold-tool-id": "hash_gen",
  "x-privacyfold-category": "crypto",
  "x-privacyfold-standard": "ECMAScript (any modern browser)",
  "x-privacyfold-engine": "none (plain JavaScript in the browser tab)",
  "x-privacyfold-accepts": "any",
  "x-privacyfold-execution-url": "https://privacyfold.com/tools/hash-gen/?mode=agent#payload",
  "type": "object",
  "properties": {
    "preset": {
      "type": "string",
      "enum": [
        "default"
      ]
    },
    "input": {
      "type": "string",
      "description": "A file or text value processed in the tab; never uploaded."
    },
    "options": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "input"
  ]
}
