{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://privacyfold.com/schemas/pdf_flatten.json",
  "title": "PDF flattener & form locker",
  "description": "Flatten interactive AcroForm fields, checkboxes, and signature appearances into static page content for IRS 1099, USCIS, and notary submissions.",
  "x-privacyfold-tool-id": "pdf_flatten",
  "x-privacyfold-category": "pdf",
  "x-privacyfold-engine": "/wasm/pdf/pdf-flatten-v1.wasm",
  "x-privacyfold-determinism-tier": "D",
  "x-privacyfold-execution-url": "https://privacyfold.com/tools/pdf_flatten?mode=agent&source=mcp#payload",
  "type": "object",
  "properties": {
    "preset": {
      "type": "string",
      "enum": [
        "us-pacer-federal-court-pdf",
        "sec-edgar-filing-pdf-prep"
      ]
    },
    "input": {
      "type": "string",
      "description": "Input text, data URI, or local File handle via data-pf='input'"
    },
    "options": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "input"
  ]
}