{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://privacyfold.com/schemas/jwt_decode.json",
  "title": "JWT decoder",
  "description": "Read what is inside a JSON Web Token. The signature is not checked, so do not treat a decoded token as trusted.",
  "x-privacyfold-tool-id": "jwt_decode",
  "x-privacyfold-category": "dev",
  "x-privacyfold-standard": "W3C Web Crypto API (SubtleCrypto)",
  "x-privacyfold-engine": "none (plain JavaScript in the browser tab)",
  "x-privacyfold-accepts": "text",
  "x-privacyfold-execution-url": "https://privacyfold.com/tools/jwt-decode/?mode=agent#payload",
  "type": "object",
  "properties": {
    "preset": {
      "type": "string",
      "enum": [
        "jwt-rs256-es256-offline-audit"
      ]
    },
    "input": {
      "type": "string",
      "description": "Text to process. Sent to the tool only through the URL fragment / local input."
    },
    "options": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "input"
  ]
}
