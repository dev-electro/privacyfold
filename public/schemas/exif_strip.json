{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://privacyfold.com/schemas/exif_strip.json",
  "title": "Photo metadata remover",
  "description": "Photos can carry hidden details such as where and when they were taken. Remove them before you share a picture.",
  "x-privacyfold-tool-id": "exif_strip",
  "x-privacyfold-category": "image",
  "x-privacyfold-engine": "/wasm/image/exif-strip-v1.wasm",
  "x-privacyfold-determinism-tier": "D",
  "x-privacyfold-execution-url": "https://privacyfold.com/tools/exif_strip?mode=agent&source=mcp#payload",
  "type": "object",
  "properties": {
    "preset": {
      "type": "string",
      "enum": [
        "default"
      ]
    },
    "input": {
      "type": "string",
      "description": "Input text, data URI, or local File handle via data-pf='input'"
    },
    "options": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "input"
  ]
}