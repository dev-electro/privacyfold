{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://privacyfold.com/schemas/csv_json.json",
  "title": "CSV ↔ JSON converter",
  "description": "Convert CSV spreadsheets into structured JSON arrays, or convert JSON arrays back into CSV rows.",
  "x-privacyfold-tool-id": "csv_json",
  "x-privacyfold-category": "dev",
  "x-privacyfold-standard": "ECMAScript (any modern browser)",
  "x-privacyfold-engine": "none (plain JavaScript in the browser tab)",
  "x-privacyfold-accepts": "text",
  "x-privacyfold-execution-url": "https://privacyfold.com/tools/csv-json/?mode=agent#payload",
  "type": "object",
  "properties": {
    "preset": {
      "type": "string",
      "enum": [
        "default"
      ]
    },
    "input": {
      "type": "string",
      "description": "Text to process. Sent to the tool only through the URL fragment / local input."
    },
    "options": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "input"
  ]
}
