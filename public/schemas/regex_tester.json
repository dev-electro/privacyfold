{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://privacyfold.com/schemas/regex_tester.json",
  "title": "Regex tester & explainer",
  "description": "Test regular expressions with live match counts, captured groups, and character positions.",
  "x-privacyfold-tool-id": "regex_tester",
  "x-privacyfold-category": "dev",
  "x-privacyfold-standard": "ECMAScript (any modern browser)",
  "x-privacyfold-engine": "none (plain JavaScript in the browser tab)",
  "x-privacyfold-accepts": "text",
  "x-privacyfold-execution-url": "https://privacyfold.com/tools/regex-tester/?mode=agent#payload",
  "type": "object",
  "properties": {
    "preset": {
      "type": "string",
      "enum": [
        "default"
      ]
    },
    "input": {
      "type": "string",
      "description": "Text to process. Sent to the tool only through the URL fragment / local input."
    },
    "options": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "input"
  ]
}
