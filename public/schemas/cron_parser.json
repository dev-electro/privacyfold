{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://privacyfold.com/schemas/cron_parser.json",
  "title": "Cron expression explainer",
  "description": "Parse cron schedule expressions into a clear, human-readable description and preview the upcoming execution times.",
  "x-privacyfold-tool-id": "cron_parser",
  "x-privacyfold-category": "dev",
  "x-privacyfold-engine": "/wasm/dev/cron-parser-v1.wasm",
  "x-privacyfold-determinism-tier": "D",
  "x-privacyfold-execution-url": "https://privacyfold.com/tools/cron_parser?mode=agent&source=mcp#payload",
  "type": "object",
  "properties": {
    "preset": {
      "type": "string",
      "enum": [
        "github-actions-cron-schedule",
        "aws-eventbridge-cron-validator"
      ]
    },
    "input": {
      "type": "string",
      "description": "Input text, data URI, or local File handle via data-pf='input'"
    },
    "options": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "input"
  ]
}