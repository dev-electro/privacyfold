{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://privacyfold.com/schemas/signature_clean.json",
  "title": "Signature cleaner",
  "description": "Lift a signature off paper onto a clear background.",
  "x-privacyfold-tool-id": "signature_clean",
  "x-privacyfold-category": "photo",
  "x-privacyfold-standard": "W3C HTML Canvas 2D",
  "x-privacyfold-engine": "none (plain JavaScript in the browser tab)",
  "x-privacyfold-accepts": "image",
  "x-privacyfold-execution-url": "https://privacyfold.com/tools/signature-clean/?mode=agent#payload",
  "type": "object",
  "properties": {
    "preset": {
      "type": "string",
      "enum": [
        "in-pan-nsdl-signature-140x60"
      ]
    },
    "input": {
      "type": "string",
      "description": "An image file (data URI or pasted File) processed in the tab; never uploaded."
    },
    "options": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "input"
  ]
}
