{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://privacyfold.com/schemas/base64.json",
  "title": "Base64 encoder and decoder",
  "description": "Convert text to Base64 and back. Handles any language and emoji.",
  "x-privacyfold-tool-id": "base64",
  "x-privacyfold-category": "dev",
  "x-privacyfold-standard": "ECMAScript (any modern browser)",
  "x-privacyfold-engine": "none (plain JavaScript in the browser tab)",
  "x-privacyfold-accepts": "text",
  "x-privacyfold-execution-url": "https://privacyfold.com/tools/base64/?mode=agent#payload",
  "type": "object",
  "properties": {
    "preset": {
      "type": "string",
      "enum": [
        "kubernetes-secret-base64-codec"
      ]
    },
    "input": {
      "type": "string",
      "description": "Text to process. Sent to the tool only through the URL fragment / local input."
    },
    "options": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "input"
  ]
}
