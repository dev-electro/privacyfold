{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://privacyfold.com/schemas/pdf_redact.json",
  "title": "Document & image redactor",
  "description": "Permanently black out or pixelate sensitive areas on a document scan or screenshot. Nothing can be recovered from the exported image.",
  "x-privacyfold-tool-id": "pdf_redact",
  "x-privacyfold-category": "pdf",
  "x-privacyfold-engine": "/wasm/pdf/pdf-redact-v1.wasm",
  "x-privacyfold-determinism-tier": "D",
  "x-privacyfold-execution-url": "https://privacyfold.com/tools/pdf_redact?mode=agent&source=mcp#payload",
  "type": "object",
  "properties": {
    "preset": {
      "type": "string",
      "enum": [
        "foia-redaction-true-byte-scrub"
      ]
    },
    "input": {
      "type": "string",
      "description": "Input text, data URI, or local File handle via data-pf='input'"
    },
    "options": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "input"
  ]
}