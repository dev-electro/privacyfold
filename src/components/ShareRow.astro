---
interface Props {
  url: string;
  title: string;
  summary?: string;
  hook?: string;
}

const { url, title, summary = '', hook = '' } = Astro.props;

const shareText = encodeURIComponent(hook || title);
const encodedUrl = encodeURIComponent(url);
const encodedSummary = encodeURIComponent(summary ? `${summary}\n\n${url}` : url);

const shareLinks = [
  {
    name: 'X',
    icon: '𝕏',
    href: `https://twitter.com/intent/tweet?text=${shareText}&url=${encodedUrl}`,
  },
  {
    name: 'WhatsApp',
    icon: 'WhatsApp',
    href: `https://wa.me/?text=${shareText}%20${encodedUrl}`,
  },
  {
    name: 'LinkedIn',
    icon: 'LinkedIn',
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`,
  },
  {
    name: 'Reddit',
    icon: 'Reddit',
    href: `https://reddit.com/submit?url=${encodedUrl}&title=${shareText}`,
  },
  {
    name: 'Email',
    icon: 'Email',
    href: `mailto:?subject=${shareText}&body=${encodedSummary}`,
  },
];
---

<div class="pf-share-row">
  <div class="pf-share-k">
    <span>Share privately</span>
    <span class="pf-share-note">0 trackers · plain links</span>
  </div>

  <div class="pf-share-links">
    <button type="button" class="pf-copy-btn" data-share-url={url}>Copy link</button>

    {shareLinks.map((link) => (
      <a
        href={link.href}
        target="_blank"
        rel="noopener noreferrer"
        class="pf-share-link"
      >
        {link.name}
      </a>
    ))}
  </div>
</div>

<style>
  .pf-share-row {
    margin: 20px 0;
    padding: 12px 16px;
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
  }
  .pf-share-k {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink-2);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .pf-share-note { font-size: 11px; opacity: 0.75; text-transform: none; letter-spacing: 0; }
  .pf-share-links { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .pf-copy-btn,
  .pf-share-link {
    padding: 5px 10px;
    font-family: var(--font-mono);
    font-size: 12px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 5px;
    color: var(--ink);
    text-decoration: none;
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
  }
  .pf-copy-btn:hover,
  .pf-share-link:hover { border-color: var(--ink); color: var(--ink); }
  .pf-share-link:focus-visible,
  .pf-copy-btn:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
</style>

<script is:inline>
  (() => {
    document.querySelectorAll('.pf-copy-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const urlToCopy = btn.getAttribute('data-share-url') || window.location.href;
        try {
          await navigator.clipboard.writeText(urlToCopy);
          const original = btn.textContent;
          btn.textContent = 'Copied!';
          btn.style.color = '#15803d';
          btn.style.borderColor = '#86efac';
          setTimeout(() => {
            btn.textContent = original;
            btn.style.color = '';
            btn.style.borderColor = '';
          }, 2000);
        } catch (e) {
          prompt('Copy link:', urlToCopy);
        }
      });
    });
  })();
</script>

