---
interface Props {
  initialToolSlug?: string;
}

const { initialToolSlug } = Astro.props;
---

<div id="pf-desk-root">
<div class="world" id="world" aria-hidden="true"><i></i><i></i><i></i></div><div class="live" id="liveF" aria-hidden="true"></div>

<!-- Hidden compatibility bridge for app-runtime.js click listeners & state updates -->
<div class="runtime-bridge" hidden aria-hidden="true" style="display:none">
  <button type="button" id="wirePill"><span id="wireReqN">0</span></button>
  <button type="button" id="openPleatTop"><span class="badge" id="pleatCountB">3</span></button>
  <button type="button" id="openQrTop"></button>
  <button type="button" id="runAirgapBtn"></button>
  <span id="atelierPaperTag"></span>
</div>

<header class="nav">
  <div class="wrap">
    <button type="button" class="brand" id="brand" aria-label="PrivacyFold home">
      <svg width="30" height="30" viewBox="0 0 30 30" aria-hidden="true"><path d="M4 3h16l7 7v17H4z" fill="#FF5A1F" stroke="#17160F" stroke-width="2" stroke-linejoin="round"/><path d="M20 3v7h7z" fill="#B7330A" stroke="#17160F" stroke-width="2" stroke-linejoin="round"/><path d="M4 27L27 10v17z" fill="rgba(0,0,0,.16)"/></svg>
      <span>PrivacyFold</span>
    </button>

    <!-- MEGA MENU NAVIGATION -->
    <nav class="nav-menu" aria-label="Main Navigation">
      <!-- Mega Menu 1: Tools & Catalog -->
      <div class="nav-item">
        <button type="button" class="nav-btn" aria-expanded="false" aria-haspopup="true">
          <span>Tools</span>
          <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M6 9l6 6 6-6"/></svg>
        </button>
        <div class="mega-panel mega-panel-tools" role="region" aria-label="Tools catalog">
          <div class="mega-grid-5">
            <!-- Col 1: Photo & ID -->
            <div class="mega-col">
              <div class="mega-col-head">📷 Photo &amp; ID</div>
              <div class="mega-col-list">
                <a href="/tools/passport-photo/" class="mega-link">
                  <span class="mega-link-title">Passport Photo</span>
                  <span class="mega-link-desc">ICAO 9303 biometric crop</span>
                </a>
                <a href="/tools/exif-strip/" class="mega-link">
                  <span class="mega-link-title">EXIF &amp; GPS Scrub</span>
                  <span class="mega-link-desc">Wipe camera metadata</span>
                </a>
                <a href="/tools/heic-to-jpg/" class="mega-link">
                  <span class="mega-link-title">HEIC to JPG</span>
                  <span class="mega-link-desc">Apple photo conversion</span>
                </a>
                <a href="/tools/signature-clean/" class="mega-link">
                  <span class="mega-link-title">Signature Clean</span>
                  <span class="mega-link-desc">Alpha threshold isolate</span>
                </a>
              </div>
            </div>

            <!-- Col 2: PDF & Docs -->
            <div class="mega-col">
              <div class="mega-col-head">📄 PDF &amp; Docs</div>
              <div class="mega-col-list">
                <a href="/tools/pdf-merge/" class="mega-link">
                  <span class="mega-link-title">PDF Merge</span>
                  <span class="mega-link-desc">Combine pages in RAM</span>
                </a>
                <a href="/tools/pdf-split/" class="mega-link">
                  <span class="mega-link-title">PDF Split</span>
                  <span class="mega-link-desc">Extract single pages</span>
                </a>
                <a href="/tools/pdf-redact/" class="mega-link">
                  <span class="mega-link-title">PDF Redaction</span>
                  <span class="mega-link-desc">Byte-level irreversible scrub</span>
                </a>
                <a href="/tools/pdf-flatten/" class="mega-link">
                  <span class="mega-link-title">PDF Flatten</span>
                  <span class="mega-link-desc">Lock form fields</span>
                </a>
              </div>
            </div>

            <!-- Col 3: Security & Crypto -->
            <div class="mega-col">
              <div class="mega-col-head">🔐 Security &amp; Crypto</div>
              <div class="mega-col-list">
                <a href="/tools/file-encrypt/" class="mega-link">
                  <span class="mega-link-title">AES-256 Encrypt</span>
                  <span class="mega-link-desc">Self-decrypting HTML</span>
                </a>
                <a href="/tools/clean-paste/" class="mega-link">
                  <span class="mega-link-title">Clean Paste</span>
                  <span class="mega-link-desc">Strip UTM &amp; hidden tokens</span>
                </a>
                <a href="/tools/password-gen/" class="mega-link">
                  <span class="mega-link-title">Password Gen</span>
                  <span class="mega-link-desc">High-entropy passphrases</span>
                </a>
                <a href="/tools/pgp-crypto/" class="mega-link">
                  <span class="mega-link-title">PGP Crypto</span>
                  <span class="mega-link-desc">P-256 WebCrypto signatures</span>
                </a>
              </div>
            </div>

            <!-- Col 4: Image & Media -->
            <div class="mega-col">
              <div class="mega-col-head">🖼️ Image &amp; Media</div>
              <div class="mega-col-list">
                <a href="/tools/image-compress/" class="mega-link">
                  <span class="mega-link-title">Image Compress</span>
                  <span class="mega-link-desc">MozJPEG / WebP WASM</span>
                </a>
                <a href="/tools/svg-optimize/" class="mega-link">
                  <span class="mega-link-title">SVG Optimize</span>
                  <span class="mega-link-desc">Minify vector paths</span>
                </a>
                <a href="/tools/bg-remove/" class="mega-link">
                  <span class="mega-link-title">Remove Background</span>
                  <span class="mega-link-desc">Client-side segmentation</span>
                </a>
                <a href="/tools/magic-eraser/" class="mega-link">
                  <span class="mega-link-title">Magic Eraser</span>
                  <span class="mega-link-desc">In-browser inpainting</span>
                </a>
              </div>
            </div>

            <!-- Col 5: Dev & Forms -->
            <div class="mega-col">
              <div class="mega-col-head">💻 Dev &amp; Forms</div>
              <div class="mega-col-list">
                <a href="/tools/json-format/" class="mega-link">
                  <span class="mega-link-title">JSON Formatter</span>
                  <span class="mega-link-desc">Parse, validate, beautify</span>
                </a>
                <a href="/tools/jwt-decode/" class="mega-link">
                  <span class="mega-link-title">JWT Decoder</span>
                  <span class="mega-link-desc">Inspect claims offline</span>
                </a>
                <a href="/tools/w9-prep/" class="mega-link">
                  <span class="mega-link-title">IRS W-9 Prep</span>
                  <span class="mega-link-desc">Private US tax worksheet</span>
                </a>
                <a href="/tools/sa100-prep/" class="mega-link">
                  <span class="mega-link-title">UK SA100 Tax</span>
                  <span class="mega-link-desc">HMRC return calculator</span>
                </a>
              </div>
            </div>
          </div>

          <!-- Mega Menu Footer -->
          <div class="mega-footer">
            <span>🛡️ All 72 tools run 100% in local browser RAM via WebAssembly &amp; WebCrypto</span>
            <div style="display:flex;gap:14px">
              <a href="#tools" data-go="tools">Browse All 72 Tools &rarr;</a>
              <a href="/tools/passport-photo/us-passport-std/">87 Official Presets &rarr;</a>
            </div>
          </div>
        </div>
      </div>

      <!-- Mega Menu 2: Architecture & Privacy -->
      <div class="nav-item">
        <button type="button" class="nav-btn" aria-expanded="false" aria-haspopup="true">
          <span>Architecture</span>
          <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M6 9l6 6 6-6"/></svg>
        </button>
        <div class="mega-panel mega-panel-dropdown" role="region" aria-label="Architecture and privacy">
          <a href="/compare/client-side-vs-server-side-file-tools/" class="mega-drop-link">
            <span class="mega-drop-icon">⚖️</span>
            <div>
              <span class="mega-drop-title">Client-Side vs Server-Side</span>
              <span class="mega-drop-sub">Why in-browser execution beats cloud file tools</span>
            </div>
          </a>
          <a href="/compare/privacyfold-vs-cloud-compressors/" class="mega-drop-link">
            <span class="mega-drop-icon">📊</span>
            <div>
              <span class="mega-drop-title">PrivacyFold vs Cloud Compressors</span>
              <span class="mega-drop-sub">Technical benchmark on compression &amp; privacy</span>
            </div>
          </a>
          <button type="button" class="mega-drop-link" data-page="ledger" style="width:100%;text-align:left;background:none;border:none">
            <span class="mega-drop-icon">🛡️</span>
            <div>
              <span class="mega-drop-title">Zero-Network Privacy Ledger</span>
              <span class="mega-drop-sub">Real-time audit of zero outbound network calls</span>
            </div>
          </button>
          <button type="button" class="mega-drop-link" data-page="webgpu" style="width:100%;text-align:left;background:none;border:none">
            <span class="mega-drop-icon">⚡</span>
            <div>
              <span class="mega-drop-title">WebGPU &amp; Local AI Airlock</span>
              <span class="mega-drop-sub">On-device inference with zero server telemetry</span>
            </div>
          </button>
        </div>
      </div>

      <!-- Mega Menu 3: Resources & Guides -->
      <div class="nav-item">
        <button type="button" class="nav-btn" aria-expanded="false" aria-haspopup="true">
          <span>Resources</span>
          <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M6 9l6 6 6-6"/></svg>
        </button>
        <div class="mega-panel mega-panel-dropdown" role="region" aria-label="Resources and guides">
          <a href="/blog/" class="mega-drop-link">
            <span class="mega-drop-icon">📚</span>
            <div>
              <span class="mega-drop-title">Engineering Blog &amp; Guides</span>
              <span class="mega-drop-sub">Deep dives on WASM, EXIF leaks &amp; security</span>
            </div>
          </a>
          <a href="/glossary/" class="mega-drop-link">
            <span class="mega-drop-icon">📖</span>
            <div>
              <span class="mega-drop-title">Technical Glossary</span>
              <span class="mega-drop-sub">15 architectural definitions (AES, OPFS, ICAO)</span>
            </div>
          </a>
          <a href="/compare/" class="mega-drop-link">
            <span class="mega-drop-icon">📑</span>
            <div>
              <span class="mega-drop-title">Architectural Comparisons</span>
              <span class="mega-drop-sub">Deep side-by-side analysis of file converters</span>
            </div>
          </a>
          <button type="button" class="mega-drop-link" data-go="developers" style="width:100%;text-align:left;background:none;border:none">
            <span class="mega-drop-icon">🤖</span>
            <div>
              <span class="mega-drop-title">Model Context Protocol (MCP)</span>
              <span class="mega-drop-sub">JSON-RPC local tooling for AI agents &amp; IDEs</span>
            </div>
          </button>
        </div>
      </div>

      <!-- Direct Item: How it works -->
      <div class="nav-item">
        <button type="button" class="nav-btn" data-go="how">
          <span>How It Works</span>
        </button>
      </div>
    </nav>

    <!-- RIGHT CONTROLS -->
    <div class="nav-r">
      <button type="button" class="nbtn mob-menu-btn" id="mobMenuBtn" aria-label="Open navigation menu" aria-expanded="false" aria-controls="mobDrawer">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
        <span class="lbl">Menu</span>
      </button>
      <button type="button" class="nbtn" id="palBtn" aria-label="Search tools">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg>
        <span class="lbl">Search</span>
        <span class="kbdk" id="kbdHint">Ctrl K</span>
      </button>
      <button type="button" class="nbtn" id="trayBtn" aria-expanded="false" aria-controls="trayp" aria-label="Your files">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 3h9l5 5v13H5z"/><path d="M14 3v5h5"/></svg>
        <span class="lbl">Desk</span>
        <span class="badge" id="trayN">0</span>
      </button>
      <button type="button" class="nbtn" id="soundBtn" aria-pressed="false" aria-label="Sound off. Turn on">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9v6h4l5 4V5L8 9z"/><path id="sndWave" d="M16.5 8.5a5 5 0 0 1 0 7M19 6a8.5 8.5 0 0 1 0 12"/></svg>
      </button>
      <button type="button" class="nbtn" id="themeBtn" aria-haspopup="menu" aria-expanded="false" aria-controls="paperP" aria-label="Paper: Follow my device. Change"></button>
      <button type="button" class="nbtn" id="playBtn" style="display:none" aria-label="Playfulness: Subtle. Change"><span id="playV">Subtle</span></button>
      <div class="paperp" id="paperP" role="menu" aria-label="Paper stock" hidden></div>
      <div class="trayp" id="trayp" hidden></div>
    </div>
  </div>
</header>

<div class="mob-drawer-wrap" id="mobDrawer" hidden aria-modal="true" role="dialog" aria-label="Navigation Menu">
  <div class="mob-backdrop" id="mobBackdrop"></div>
  <div class="mob-drawer-panel">
    <div class="mob-d-head">
      <button type="button" class="brand" id="mobBrand" style="padding:0">
        <svg width="24" height="24" viewBox="0 0 30 30" aria-hidden="true"><path d="M4 3h16l7 7v17H4z" fill="#FF5A1F" stroke="#17160F" stroke-width="2" stroke-linejoin="round"/><path d="M20 3v7h7z" fill="#B7330A" stroke="#17160F" stroke-width="2" stroke-linejoin="round"/></svg>
        PrivacyFold
      </button>
      <button type="button" class="nbtn" id="mobDrawerClose" aria-label="Close menu" style="min-width:38px;min-height:38px"><svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg></button>
    </div>
    <div class="mob-d-nav">
      <button type="button" data-mob-go="tools">All Tools <span>72</span></button>
      <a href="/compare/" class="mob-d-link" style="padding:10px 12px;font-weight:600;text-decoration:none;color:var(--ink);display:flex;justify-content:space-between">Compare vs Cloud <span>2 articles</span></a>
      <a href="/blog/" class="mob-d-link" style="padding:10px 12px;font-weight:600;text-decoration:none;color:var(--ink);display:flex;justify-content:space-between">Guides &amp; Blog <span>6 articles</span></a>
      <a href="/glossary/" class="mob-d-link" style="padding:10px 12px;font-weight:600;text-decoration:none;color:var(--ink);display:flex;justify-content:space-between">Glossary <span>15 terms</span></a>
      <button type="button" data-mob-page="ledger">Privacy Ledger <span>0 uploads</span></button>
      <button type="button" data-mob-page="webgpu">WebGPU &amp; AI Hub <span class="tag">GPU</span></button>
    </div>
    <div class="mob-d-sec">
      <h4>Tool Categories (72 Tools)</h4>
      <div class="mob-cat-grid">
        <button type="button" class="mob-cat-btn" data-mob-fam="photo">Photo &amp; ID</button>
        <button type="button" class="mob-cat-btn" data-mob-fam="image">Images</button>
        <button type="button" class="mob-cat-btn" data-mob-fam="pdf">PDF &amp; Docs</button>
        <button type="button" class="mob-cat-btn" data-mob-fam="dev">Developer</button>
        <button type="button" class="mob-cat-btn" data-mob-fam="crypto">Security</button>
        <button type="button" class="mob-cat-btn" data-mob-fam="forms">Tax &amp; Forms</button>
      </div>
    </div>
    <div class="mob-d-sec">
      <h4>Quick Privacy Actions</h4>
      <div style="display:grid;gap:6px">
        <button type="button" class="btn sm block" id="mobCheckupBtn">File Privacy Checkup</button>
        <button type="button" class="btn ghost sm block" id="mobQrBtn">Share via QR Code</button>
        <button type="button" class="btn ghost sm block" id="mobAuditBtn">Run Privacy Audit</button>
      </div>
    </div>
  </div>
</div>

<main>
<div id="home">
  <section class="hero">
    <canvas id="bg" aria-hidden="true"></canvas><div class="world inhero" aria-hidden="true"><i></i><i></i><i></i></div><div class="live inhero" id="liveH" aria-hidden="true"></div>
    <div class="wrap">
      <div>
        <div class="eyebrow"><i></i>Free · No sign-up · Runs in your browser</div>
        <h1>File tools that never <u>see your files</u>.</h1>
        <p class="lede">Resize passport photos, compress images, format JSON and more. Everything runs on your device, so your files are never uploaded to a server.</p>
        <div class="row">
          <button type="button" class="btn primary" id="heroPick">Choose a file</button>
          <button type="button" class="btn" data-go="tools">Browse all tools</button>
        </div>
        <div class="trust">
          <span><svg viewBox="0 0 24 24"><path d="M5 12l5 5 9-10"/></svg>No uploads</span>
          <span><svg viewBox="0 0 24 24"><path d="M5 12l5 5 9-10"/></svg>No account</span>
          <span><svg viewBox="0 0 24 24"><path d="M5 12l5 5 9-10"/></svg>Open to inspection</span>
        </div>
      </div>
      <div class="up" id="up">
        <div class="crane" aria-hidden="true">
          <svg viewBox="0 0 160 120"><polygon class="c3" points="70,66 100,12 108,68"/><polygon class="c2" points="52,72 30,32 38,30 66,66"/><polygon class="c6" points="30,32 14,27 36,29"/><polygon class="c1" points="52,72 92,58 118,74 78,88"/><polygon class="c5" points="78,88 118,74 98,94"/><polygon class="c3" points="118,74 152,54 120,66"/><polygon class="c4" points="78,76 132,110 100,70"/></svg>
        </div>
        <div id="upEmpty">
          <div class="drop" id="drop">
            <svg class="ico" viewBox="0 0 48 48" aria-hidden="true"><path class="pp" d="M6 4h26l10 10v30H6z" fill="#F5B82E"/><path class="pp" d="M32 4v10h10z" fill="#B88400"/><path d="M6 44L42 14v30z" fill="rgba(0,0,0,.14)"/><path d="M24 36V22M18 28l6-6 6 6" fill="none" stroke="#17160F" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <h2>Drop a file here</h2>
            <p>Photos, PDFs, text or JSON. You can also paste from your clipboard.</p>
            <button type="button" class="btn primary" id="pickBtn">Choose a file</button>
            <input type="file" id="file" data-pf="input" multiple hidden>
          </div>
          <div class="quick"><span class="qlab">Or try a tool:</span>
            <button type="button" class="chipb" data-tool="passport_photo">Passport photo</button>
            <button type="button" class="chipb" data-tool="image_compress">Compress image</button>
            <button type="button" class="chipb" data-tool="exif_strip">Hidden photo data</button>
            <button type="button" class="chipb" data-tool="json_format">Format JSON</button>
            <button type="button" class="chipb" id="heroCheckupBtn">Privacy checkup</button>
          </div>
        </div>
        <div id="upSug" hidden>
          <div class="sug-h"><h2>Suggested tools for your file</h2><button type="button" class="btn ghost sm" id="upClear">Remove file</button></div>
          <div class="filechip" id="upFile"></div>
          <div class="sug" id="sugList"></div>
        </div>
      </div>
    </div>
    <div class="wrap" style="padding-top:0;padding-bottom:36px;position:relative;z-index:2">
      <div class="stamp-rack" id="homeStampRack" aria-label="Desk Stamp Rack">
        <div class="sr-head">
          <span class="sr-t"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M9 3h6l1 7H8L9 3z"/><rect x="4" y="10" width="16" height="5" rx="2"/><path d="M6 19h12"/></svg>Quick Presets · One-Click Workflows</span>
          <span class="sr-sub">Click any preset—or drop a file directly onto it—to process your file immediately. You can save your own presets inside any tool.</span>
        </div>
        <div class="sr-list" id="homeStampList"></div>
      </div>
    </div>
  </section>

  <section class="sec" id="tools">
    <div class="wrap">
      <div class="sec-head">
        <div><div class="kick">All tools</div><h2 class="big">Pick a tool. Add a file. Download.</h2></div>
        <p class="sec-sub">Every tool works the same way, so once you have used one you know them all.</p>
      </div>
      <div class="chips" id="chips" role="group" aria-label="Filter by category"></div>
      <div class="grid" id="grid"></div>
      <p class="count" id="count"></p>
    </div>
  </section>

  <div class="zig" aria-hidden="true"></div>
  <section class="sec tint" id="how">
    <div class="wrap">
      <div class="sec-head"><div><div class="kick">How it works</div><h2 class="big">Three steps, and none of them upload anything.</h2></div></div>
      <div class="steps">
        <div class="step"><svg viewBox="0 0 210 110" aria-hidden="true"><path d="M20 90h170" stroke="var(--ink)" stroke-width="2" stroke-linecap="round"/><path d="M84 18h40l14 14v40H84z" fill="#F5B82E" stroke="var(--ink)" stroke-width="2" stroke-linejoin="round"/><path d="M124 18v14h14z" fill="#B88400" stroke="var(--ink)" stroke-width="2" stroke-linejoin="round"/><path d="M110 78V50m-9 9l9-9 9 9" fill="none" stroke="var(--ink)" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg><div class="n">STEP 1</div><h3>Add a file</h3><p>Drop it on the page, choose it from your computer, or paste text. It opens inside this browser tab.</p></div>
        <div class="step"><svg viewBox="0 0 210 110" aria-hidden="true"><g stroke="var(--ink)" stroke-width="2" stroke-linecap="round"><path d="M28 28h154M28 55h154M28 82h154"/></g><g fill="#FF5A1F" stroke="var(--ink)" stroke-width="2"><circle cx="64" cy="28" r="9"/><circle cx="132" cy="55" r="9"/><circle cx="92" cy="82" r="9"/></g></svg><div class="n">STEP 2</div><h3>Adjust the settings</h3><p>See a live preview as you change size, quality or format. Basic settings first, Advanced when you want control.</p></div>
        <div class="step"><svg viewBox="0 0 210 110" aria-hidden="true"><path d="M84 12h40l14 14v50H84z" fill="#1FAE85" stroke="var(--ink)" stroke-width="2" stroke-linejoin="round"/><path d="M124 12v14h14z" fill="#0E7355" stroke="var(--ink)" stroke-width="2" stroke-linejoin="round"/><path d="M110 40v26m-9-9l9 9 9-9" fill="none" stroke="var(--ink)" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M60 94h90" stroke="var(--ink)" stroke-width="2" stroke-linecap="round"/></svg><div class="n">STEP 3</div><h3>Download the result</h3><p>Check the before and after, then save the file. Delete it from the tab with one click when you are done.</p></div>
      </div>
      <div class="why" id="privacy">
        <div>
          <h3>Why your files stay private</h3>
          <p>Each tool runs inside your browser tab, using your own computer. Our servers only send you the page. They never receive your file, because there is nowhere in the page to send it. While a tool works you will see a paper envelope close over your file. That is our way of showing that it stays sealed in your tab.</p>
        </div>
        <svg class="diagram" viewBox="0 0 420 170" role="img" aria-label="Your file stays inside your browser. Nothing goes to the internet or our servers.">
          <rect x="8" y="14" width="200" height="140" rx="12" fill="var(--surface-2)" stroke="var(--ink)" stroke-width="1.8"/>
