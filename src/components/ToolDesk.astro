<script is:inline>
  // Accessible Mega Menu Click and Outside-Click Handler
  document.querySelectorAll('.nav-item > .nav-btn').forEach(function(btn) {
    btn.addEventListener('click', function(e) {
      var item = btn.closest('.nav-item');
      if (!item.querySelector('.mega-panel')) return; // direct links continue
      var isOpen = item.classList.contains('open');
      document.querySelectorAll('.nav-item.open').forEach(function(el) {
        el.classList.remove('open');
        var b = el.querySelector('.nav-btn');
        if (b) b.setAttribute('aria-expanded', 'false');
      });
      if (!isOpen) {
        item.classList.add('open');
        btn.setAttribute('aria-expanded', 'true');
        e.stopPropagation();
      }
    });
  });
  document.addEventListener('click', function(e) {
    if (!e.target.closest('.nav-item')) {
      document.querySelectorAll('.nav-item.open').forEach(function(el) {
        el.classList.remove('open');
        var b = el.querySelector('.nav-btn');
        if (b) b.setAttribute('aria-expanded', 'false');
      });
    }
  });
</script>
