---
import AdSlot from './AdSlot.astro';

interface Props {
  slotId?: string;
  format?: 'leaderboard' | 'rectangle' | 'in-article';
  className?: string;
}

const { slotId = 'tool-mid', format = 'in-article', className = '' } = Astro.props;
const slotFormat = format === 'leaderboard' ? 'banner' : format === 'rectangle' ? 'sidebar' : 'in-article';
---

<AdSlot slotKey={slotId} format={slotFormat} className={className} />
