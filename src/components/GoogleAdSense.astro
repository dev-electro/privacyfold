---
import { ADS_CONFIG } from '../config/ads';

interface Props {
  pageType?: 'tool' | 'template' | 'blog' | 'glossary' | 'home';
}

const { pageType = 'tool' } = Astro.props;
---

{ADS_CONFIG.enabled && (
  <Fragment>
    <link rel="preconnect" href="https://pagead2.googlesyndication.com" crossorigin />
    <link rel="preconnect" href="https://googleads.g.doubleclick.net" crossorigin />
    <link rel="preconnect" href="https://tpc.googlesyndication.com" crossorigin />
    <script is:inline>
      window.adsbygoogle = window.adsbygoogle || [];
      try {
        var pfConsent = localStorage.getItem('pf_consent');
        if (pfConsent !== 'all') {
          window.adsbygoogle.requestNonPersonalizedAds = 1;
        }
      } catch (e) {
        window.adsbygoogle.requestNonPersonalizedAds = 1;
      }
    </script>
    <script
      is:inline
      async
      src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADS_CONFIG.publisherId}`}
      crossorigin="anonymous"
      onload="window.__adsenseLoaded=true"
      onerror="window.__adsenseLoaded=false"
    ></script>
  </Fragment>
)}
