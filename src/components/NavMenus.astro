---
/**
 * Shared site navigation (menu bar) — used by the ToolDesk header and by
 * content pages (compare / glossary / blog) that don't mount the desk runtime.
 * Menus are generated from the Git CMS: one tool record drives the nav (DEC-004).
 */
import { getAllToolsFromGit, getAllPresetsFromGit, getAvailableLocales } from '../lib/cms';

interface Props {
  lang?: string;
  currentPath?: string;
}

const { lang = 'en', currentPath = '/' } = Astro.props;

const CAT_ORDER = [
  { key: 'photo', label: 'Photo', icon: 'camera' },
  { key: 'image', label: 'Images', icon: 'image' },
  { key: 'pdf', label: 'PDF', icon: 'file' },
  { key: 'crypto', label: 'Security', icon: 'shield' },
  { key: 'dev', label: 'Developer', icon: 'code' },
  { key: 'forms', label: 'Forms', icon: 'clipboard' },
];
const allTools = getAllToolsFromGit();
const short = (d: string) => (d.length > 56 ? d.slice(0, 53).replace(/\s+\S*$/, '') + '…' : d);
const cats = CAT_ORDER.map((c) => ({
  ...c,
  tools: allTools
    .filter((t: any) => (t.category || t.fam) === c.key)
    .sort((a: any, b: any) => a.name.localeCompare(b.name)),
})).filter((c) => c.tools.length > 0);
const totalTools = allTools.length;
const presets = getAllPresetsFromGit()
  .map((p: any) => ({ slug: p.presetSlug || p.id, toolSlug: p.toolSlug, title: p.title }))
  .sort((a: any, b: any) => a.title.localeCompare(b.title));

const locales = getAvailableLocales();
const stripLang = (p) => {
  const m = p.match(/^\/([a-z]{2})(\/|$)/);
  return m && locales.includes(m[1]) ? (p.slice(m[0].length - 1) || '/') : p;
};
const basePath = stripLang(currentPath);
const langLinks = [{ code: 'en', label: 'English' }, ...locales.filter((l) => l !== 'en').map((l) => ({ code: l, label: l.toUpperCase() }))]
  .map((l) => ({ ...l, href: l.code === 'en' ? basePath : `/${l.code}${basePath === '/' ? '/' : basePath}` }));
const currentLangLabel = (langLinks.find((l) => l.code === lang) || langLinks[0]).label;
---
<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
  <defs>
    <g id="i-camera"><path d="M4 8h4l2-3h4l2 3h4v12H4z"/><circle cx="12" cy="14" r="3.5"/></g>
    <g id="i-image"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="9" cy="10" r="2"/><path d="M3 17l5-5 4 4 3-3 6 6"/></g>
    <g id="i-file"><path d="M6 3h8l5 5v13H6z"/><path d="M14 3v5h5"/><path d="M9 12h6M9 16h6"/></g>
    <g id="i-shield"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/></g>
    <g id="i-code"><path d="M8 7l-5 5 5 5M16 7l5 5-5 5"/></g>
    <g id="i-clipboard"><rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 4V2h6v2"/><path d="M9 10h6M9 14h6"/></g>
    <g id="i-target"><circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="4"/><circle cx="12" cy="12" r="1" fill="currentColor" stroke="none"/></g>
    <g id="i-book"><path d="M4 5a2 2 0 0 1 2-2h14v16H6a2 2 0 0 0-2 2z"/><path d="M4 19a2 2 0 0 1 2-2h14"/></g>
    <g id="i-globe"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3.5 3 14.5 0 18-3-3.5-3-14.5 0-18z"/></g>
    <g id="i-layers"><path d="M12 3l8 4.5-8 4.5-8-4.5z"/><path d="M4 12l8 4.5 8-4.5"/><path d="M4 16.5L12 21l8-4.5"/></g>
    <g id="i-chev"><path d="M6 9l6 6 6-6"/></g>
    <g id="i-menu"><path d="M4 6h16M4 12h16M4 18h16"/></g>
  </defs>
</svg>

<nav class="nav-menu" aria-label="Main Navigation">
  {cats.map((c) => (
    <div class="nav-item">
      <button type="button" class="nav-btn" aria-expanded="false" aria-haspopup="true">
        <svg class="cat-ico" viewBox="0 0 24 24"><use href={`#i-${c.icon}`}/></svg>
        <span>{c.label}</span>
        <svg class="chev" viewBox="0 0 24 24"><use href="#i-chev"/></svg>
      </button>
      <div class="mega-panel mega-panel-cat" role="region" aria-label={`${c.label} tools`}>
        <div class="cat-head"><svg class="cat-ico" viewBox="0 0 24 24"><use href={`#i-${c.icon}`}/></svg><b>{c.label}</b><span>{c.tools.length} tools · run in your browser</span></div>
        <div class="cat-grid">
          {c.tools.map((t: any) => (
            <a href={`/tools/${t.slug}/`} class="mega-link" title={t.description}>
              <span class="mega-link-title">{t.name}</span>
              <span class="mega-link-desc">{short(t.description || '')}</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  ))}
  <div class="nav-item">
    <button type="button" class="nav-btn" aria-expanded="false" aria-haspopup="true">
      <svg class="cat-ico" viewBox="0 0 24 24"><use href="#i-target"/></svg>
      <span>Presets</span>
      <svg class="chev" viewBox="0 0 24 24"><use href="#i-chev"/></svg>
    </button>
    <div class="mega-panel mega-panel-cat wide" role="region" aria-label="Portal presets">
      <div class="cat-head"><svg class="cat-ico" viewBox="0 0 24 24"><use href="#i-target"/></svg><b>Portal presets</b><span>{presets.length} one-click setups</span></div>
      <div class="cat-grid three">
        {presets.map((p) => (
          <a href={`/tools/${p.toolSlug}/${p.slug}/`} class="mega-link" title={p.title}>
            <span class="mega-link-title">{p.title}</span>
            <span class="mega-link-desc">{p.toolSlug} preset</span>
          </a>
        ))}
      </div>
    </div>
  </div>
  <div class="nav-item">
    <button type="button" class="nav-btn" aria-expanded="false" aria-haspopup="true">
      <svg class="cat-ico" viewBox="0 0 24 24"><use href="#i-book"/></svg>
      <span>Learn</span>
      <svg class="chev" viewBox="0 0 24 24"><use href="#i-chev"/></svg>
    </button>
    <div class="mega-panel mega-panel-dropdown" role="region" aria-label="Learn">
      <button type="button" class="mega-drop-link" data-go="how" style="width:100%;text-align:left;background:none;border:none">
        <span class="mega-drop-icon"><svg class="cat-ico" viewBox="0 0 24 24"><use href="#i-camera"/></svg></span>
        <div><span class="mega-drop-title">How it works</span><span class="mega-drop-sub">Add a file, adjust, download — nothing uploads</span></div>
      </button>
      <button type="button" class="mega-drop-link" data-go="privacy" style="width:100%;text-align:left;background:none;border:none">
        <span class="mega-drop-icon"><svg class="cat-ico" viewBox="0 0 24 24"><use href="#i-shield"/></svg></span>
        <div><span class="mega-drop-title">Why your files stay private</span><span class="mega-drop-sub">See the zero-network proof yourself</span></div>
      </button>
      <a href="/blog/" class="mega-drop-link">
        <span class="mega-drop-icon"><svg class="cat-ico" viewBox="0 0 24 24"><use href="#i-book"/></svg></span>
        <div><span class="mega-drop-title">Guides &amp; blog</span><span class="mega-drop-sub">EXIF leaks, photo standards, cryptography</span></div>
      </a>
      <a href="/compare/" class="mega-drop-link">
        <span class="mega-drop-icon"><svg class="cat-ico" viewBox="0 0 24 24"><use href="#i-file"/></svg></span>
        <div><span class="mega-drop-title">Compare with cloud tools</span><span class="mega-drop-sub">Side-by-side with online converters</span></div>
      </a>
    </div>
  </div>
</nav>

<div class="lang-wrap" id="langWrap">
  <button type="button" class="nbtn lang-btn" id="langBtn" aria-haspopup="menu" aria-expanded="false" aria-controls="langP" aria-label="Language">
    <svg class="cat-ico" viewBox="0 0 24 24"><use href="#i-globe"/></svg>
    <span class="lbl">{currentLangLabel.slice(0, 2).toUpperCase()}</span>
    <svg class="chev" viewBox="0 0 24 24"><use href="#i-chev"/></svg>
  </button>
  <div class="lang-panel" id="langP" role="menu" hidden>
    {langLinks.map((l) => (
      <a href={l.href} class="lang-item" role="menuitem" data-lang={l.code}>{l.label}</a>
    ))}
  </div>
</div>

<script is:inline>
  // Mega-menu open/close: real toggle (2nd click closes), Escape, outside click,
  // close on mouse-leave of the whole item, close when a link is chosen.
  (function () {
    function closeAll(except) {
      document.querySelectorAll('.nav-item.open').forEach(function (el) {
        if (el === except) return;
        el.classList.remove('open');
        var b = el.querySelector('.nav-btn');
        if (b) b.setAttribute('aria-expanded', 'false');
      });
    }
    document.querySelectorAll('.nav-item > .nav-btn').forEach(function (btn) {
      var item = btn.closest('.nav-item');
      if (!item.querySelector('.mega-panel')) return;
      btn.addEventListener('click', function (e) {
        var isOpen = item.classList.contains('open');
        closeAll(item);
        item.classList.toggle('open', !isOpen);
        btn.setAttribute('aria-expanded', String(!isOpen));
        e.stopPropagation();
      });
      item.addEventListener('mouseleave', function () {
        if (item.classList.contains('open')) {
          item.classList.remove('open');
          btn.setAttribute('aria-expanded', 'false');
        }
      });
    });
    document.addEventListener('click', function (e) {
      if (!e.target.closest('.nav-item')) closeAll(null);
      var lb = e.target.closest('#langBtn');
      var lp = document.getElementById('langP');
      if (lb) { lp.hidden = !lp.hidden; return; }
      if (lp && !lp.hidden && !e.target.closest('#langP')) lp.hidden = true;
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') { closeAll(null); var lp = document.getElementById('langP'); if (lp) lp.hidden = true; }
    });
    document.querySelectorAll('.mega-panel a').forEach(function (a) {
      a.addEventListener('click', function () { closeAll(null); });
    });
  })();
</script>
