---
import type { GitCmsTool } from '../lib/cms';
import { getAllToolsFromGit, getToolTranslations, FAMILIES } from '../lib/cms';
import AdSlot from './AdSlot.astro';
import ShareRow from './ShareRow.astro';

interface Props {
  tool: GitCmsTool;
  presetTitle?: string;
  presetDesc?: string;
  currentLocale?: string;
  translations?: Array<{ locale: string; slug: string }>;
}

const { tool, presetTitle, presetDesc, currentLocale = 'en', translations = [] } = Astro.props;
const famName = FAMILIES[tool.fam]?.name || 'Utility';
const related = getAllToolsFromGit().filter((t) => t.fam === tool.fam && t.id !== tool.id).slice(0, 4);

const LOCALE_LABELS: Record<string, string> = {
  en: 'English',
  es: 'Español',
  hi: 'हिन्दी',
  de: 'Deutsch',
  fr: 'Français',
  ja: '日本語',
  pt: 'Português',
  it: 'Italiano',
  zh: '简体中文',
  ar: 'العربية',
  ko: '한국어',
  ru: 'Русский',
  nl: 'Nederlands',
  id: 'Bahasa Indonesia',
  tr: 'Türkçe',
  pl: 'Polski',
  vi: 'Tiếng Việt',
  th: 'ไทย',
  sv: 'Svenska',
  uk: 'Українська',
  el: 'Ελληνικά',
  cs: 'Čeština',
  ro: 'Română',
  bn: 'বাংলা',
  he: 'עברית',
};

const chip = (active: boolean) =>
  active
    ? 'padding:3px 9px;border-radius:5px;text-decoration:none;font-size:12px;font-family:var(--font-mono);background:var(--ink);color:var(--ground);font-weight:600;border:1px solid var(--ink)'
    : 'padding:3px 9px;border-radius:5px;text-decoration:none;font-size:12px;font-family:var(--font-mono);background:var(--surface);color:var(--ink);border:1px solid var(--line)';
---

<div class="seo-wrap">
  <div class="seo-main">
    <AdSlot slotKey="tool-top" format="banner" pageType="tool" />

    <article class="seo-card">
      <div class="kick">{famName} · user guide</div>
      <h2>{presetTitle || 'How it works on your device'}</h2>

      {translations && translations.length > 0 && (
        <div class="lang-strip">
          <span class="lang-k">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
            Available in
          </span>
          <a href={`/tools/${tool.slug}/`} style={chip(currentLocale === 'en' || !currentLocale)}>English</a>
          {translations.map((tr) => (
            <a href={`/${tr.locale}/tools/${tr.slug}/`} style={chip(currentLocale === tr.locale)}>
              {LOCALE_LABELS[tr.locale] || tr.locale.toUpperCase()}
            </a>
          ))}
        </div>
      )}

      <div class="aeo-box">
        <span class="aeo-k">In short</span>
        <p>{tool.seo.aeoSummary}</p>
      </div>

      <div class="notice-privacy-ads">
        <strong>Nothing is uploaded.</strong> Your file is processed in this tab and never leaves the device. This page carries Google AdSense ads, which keep the tools free without accounts or subscriptions.
      </div>

      <ShareRow
        url={currentLocale && currentLocale !== 'en' ? `https://privacyfold.com/${currentLocale}/tools/${tool.slug}/` : `https://privacyfold.com/tools/${tool.slug}/`}
        title={presetTitle || tool.name}
        summary={tool.seo.aeoSummary}
        hook={tool.social?.hook}
      />

      <p>{presetDesc || tool.desc}</p>

      <h3>Step by step</h3>
      <ol>
        {tool.seo.steps.map((step) => (
          <li>{step}</li>
        ))}
      </ol>

      {tool.settingsExplained && tool.settingsExplained.length > 0 && (
        <>
          <h3>Every setting, explained</h3>
          <div class="settings-list">
            {tool.settingsExplained.map((s) => (
              <div class="setting">
                <div class="setting-t">{s.name}</div>
                <p class="setting-d">{s.description}</p>
                <div class="setting-m">
                  <span>Safe default: <code>{s.safeDefault}</code></span>
                  <span>Example: <em>{s.example}</em></span>
                </div>
              </div>
            ))}
          </div>
        </>
      )}

      {tool.whatToExpect && (
        <>
          <h3>What to expect</h3>
          <p>{tool.whatToExpect.results}</p>
          <div class="bench-box">
            <div><strong>Speed:</strong> {tool.whatToExpect.benchmarks}</div>
            <div><strong>Limits:</strong> {tool.whatToExpect.limits}</div>
          </div>
        </>
      )}

      {tool.privacyProof && (
        <>
          <h3>How to verify it stays local</h3>
          <p>{tool.privacyProof.howItWorks}</p>
          <ol>
            {tool.privacyProof.verificationSteps.map((step) => (
              <li>{step}</li>
            ))}
          </ol>
          <p class="muted-note">{tool.privacyProof.openSourceNotice}</p>
        </>
      )}

      <h3>This tool vs. an online converter</h3>
      <div class="tbl-wrap">
        <table class="spec-tbl">
          <thead>
            <tr>
              <th>Attribute</th>
              <th>PrivacyFold (this tab)</th>
              <th>Typical online converter</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Runs in</strong></td>
              <td>{tool.wasmModule} (browser memory)</td>
              <td>Someone else's server</td>
            </tr>
            <tr>
              <td><strong>Standard</strong></td>
              <td>{tool.std}</td>
              <td>Undisclosed scripts</td>
            </tr>
            <tr>
              <td><strong>Data sent</strong></td>
              <td><strong>0 KB</strong> of your file</td>
              <td>The whole file</td>
            </tr>
            <tr>
              <td><strong>Offline</strong></td>
              <td>Works once loaded (PWA)</td>
              <td>Not at all</td>
            </tr>
            <tr>
              <td><strong>Automation</strong></td>
              <td>Deterministic JSON-RPC / MCP</td>
              <td>Upload form only</td>
            </tr>
          </tbody>
        </table>
      </div>

      <h3>Frequently asked questions</h3>
      <div class="faq-list">
        {tool.seo.faqs.map((faq) => (
          <details class="faq-item">
            <summary class="faq-q">{faq.question}</summary>
            <p class="faq-a">{faq.answer}</p>
          </details>
        ))}
      </div>

      {tool.byline && (
        <div class="byline-box">
          <div class="byline-meta">
            <span>Written by <strong>{tool.byline.author}</strong></span>
            <span>Reviewed by <strong>{tool.byline.reviewer}</strong> · {tool.byline.reviewedDate}</span>
          </div>
          {tool.byline.sources && tool.byline.sources.length > 0 && (
            <div class="byline-src">
              <span>Sources: </span>
              {tool.byline.sources.map((s, idx) => (
                <span>
                  {idx > 0 && ' · '}
                  <a href={s.url} target="_blank" rel="noopener noreferrer">{s.name}</a>
                </span>
              ))}
            </div>
          )}
        </div>
      )}
    </article>

    <AdSlot slotKey="tool-bottom" format="in-article" pageType="tool" />
  </div>

  <aside class="seo-side">
    <div class="side-card">
      <div class="side-t">More {famName} tools</div>
      <div class="side-list">
        {related.map((rel) => {
          const relHasLocale = currentLocale && currentLocale !== 'en' && getToolTranslations(rel.id).some((t) => t.locale === currentLocale);
          const relHref = relHasLocale ? `/${currentLocale}/tools/${rel.slug}/` : `/tools/${rel.slug}/`;
          return (
            <a href={relHref} class="side-link">
              <div class="side-link-body">
                <div class="side-link-t">{rel.name}</div>
                <div class="side-link-d">{rel.tag}</div>
              </div>
              <span class="side-arrow" aria-hidden="true">→</span>
            </a>
          );
        })}
      </div>
    </div>

    <div class="side-card side-card-2">
      <div class="side-t">Standard used</div>
      <p class="side-p">Checked against <code>{tool.std}</code>. Built for a local, zero-upload workflow.</p>
      <a href="/about/" class="side-more">How we verify this →</a>
    </div>

    <AdSlot slotKey="tool-sidebar" format="sidebar" pageType="tool" />
  </aside>
</div>

<style>
  .kick {
    font: 600 11px/1 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 10px;
  }
  .lang-strip {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: 7px;
    margin: 14px 0 18px;
    padding: 10px 12px;
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: 8px;
    overflow-x: auto;
    scrollbar-width: thin;
    -webkit-overflow-scrolling: touch;
  }
  .lang-strip > * { flex: none; }
  .lang-k {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font: 600 12px var(--font-mono);
    color: var(--ink);
    margin-right: 4px;
    position: sticky;
    left: 0;
    background: var(--surface-2);
    padding-right: 6px;
  }
  .notice-privacy-ads {
    margin: 16px 0 22px;
    padding: 12px 15px;
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-left: 3px solid var(--accent);
    border-radius: 0 8px 8px 0;
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--ink-2);
  }
  .notice-privacy-ads strong { color: var(--ink); }
  .settings-list { display: grid; gap: 12px; margin: 14px 0 22px; }
  .setting {
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 13px 15px;
  }
  .setting-t { font-weight: 650; color: var(--ink); font-size: 15px; }
  .setting-d { margin: 5px 0 8px; font-size: 14px; color: var(--ink-2); line-height: 1.5; }
  .setting-m { display: flex; flex-wrap: wrap; gap: 4px 14px; font-size: 12.5px; color: var(--ink-2); }
  .setting-m code {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 1px 5px;
    overflow-wrap: anywhere;
  }
  .bench-box {
    background: var(--surface-2);
    border-left: 3px solid var(--ok);
    border-radius: 0 8px 8px 0;
    padding: 12px 15px;
    margin: 12px 0 20px;
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--ink-2);
  }
  .bench-box strong { color: var(--ink); }
  .bench-box div + div { margin-top: 4px; }
  .muted-note { font-size: 13px; color: var(--ink-2); font-style: italic; margin-top: 10px; }
  .tbl-wrap { overflow-x: auto; }
  .spec-tbl { min-width: 520px; }
  .faq-list { display: grid; gap: 10px; margin-top: 12px; }
  .byline-box {
    margin-top: 30px;
    padding: 15px 18px;
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: 10px;
  }
  .byline-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    font-size: 12.5px;
    color: var(--ink-2);
    font-family: var(--font-mono);
  }
  .byline-meta strong { color: var(--ink); }
  .byline-src { margin-top: 8px; font-size: 12.5px; color: var(--ink-2); }
  .byline-src a { color: var(--focus); text-decoration: underline; text-underline-offset: 2px; }
  .side-glyph { font-size: 11px; opacity: 0.7; }
  .side-arrow { color: var(--ink-2); font-size: 13px; opacity: 0; transition: opacity .15s, transform .15s; }
  .side-link:hover .side-arrow { opacity: 1; transform: translateX(2px); }
  .side-link-body { flex: 1; min-width: 0; }
  .side-card-2 { margin-top: 16px; }
  .side-p { font-size: 13px; color: var(--ink-2); line-height: 1.5; margin-bottom: 8px; }
  .side-p code, .side-card code { overflow-wrap: anywhere; font-family: var(--font-mono); }
  .side-more { color: var(--focus); font-size: 13px; text-decoration: none; }
  .side-more:hover { text-decoration: underline; }
</style>
