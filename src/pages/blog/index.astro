---
import SiteNav from '../../components/SiteNav.astro';
import Base from '../../layouts/Base.astro';
import { getAllBlogsFromGit } from '../../lib/cms';
import AdSlot from '../../components/AdSlot.astro';

const posts = getAllBlogsFromGit();
---

<Base
  title="Guides, Biometric Standards & Privacy Architecture Blog"
  description="Deep-dive guides on client-side WebAssembly, WebGPU AI models, passport photo standards, EXIF metadata removal, and zero-knowledge cryptography."
  canonicalUrl="https://privacyfold.com/blog/"
  pageType="blog"
>
  <SiteNav />
  <main class="wrap pg" style="padding-top: 40px; padding-bottom: 80px;">
    <div class="pg-h">
      <span class="mono eyebrow">GUIDES, STANDARDS &amp; ARCHITECTURE BLOG</span>
      <h1>Deep-dive guides &amp; documentation</h1>
      <p class="pg-sub">
        Comprehensive tutorials, official biometric and cryptographic specifications, and privacy engineering guides managed in Git.
      </p>
    </div>

    <AdSlot slotKey="blog-top" format="banner" pageType="blog" />

    <div class="blog-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 24px; margin-top: 32px;">
      {posts.map((post) => (
        <a href={`/blog/${post.slug}/`} class="blog-card" style="text-decoration: none; display: flex; flex-direction: column; background: var(--paper); border: 2px solid var(--line); border-radius: 12px; padding: 24px; box-shadow: 0 4px 0 var(--hard); transition: transform 0.1s, box-shadow 0.1s;">
          <span class="mono" style="font-size: 12px; color: var(--ink-2); text-transform: uppercase; margin-bottom: 8px;">
            {post.category} · {post.readTime}
          </span>
          <h2 style="font-size: 20px; font-weight: 700; color: var(--p-ink); margin: 0 0 12px 0; line-height: 1.3;">
            {post.title}
          </h2>
          <p style="font-size: 14.5px; color: var(--p-ink-2); line-height: 1.6; flex: 1; margin: 0 0 16px 0;">
            {post.summary}
          </p>
          <span class="mono" style="font-size: 13px; font-weight: 600; color: var(--focus);">
            Read full guide →
          </span>
        </a>
      ))}
    </div>
  </main>
</Base>
