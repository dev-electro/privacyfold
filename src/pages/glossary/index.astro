---
import Base from '../../layouts/Base.astro';
import { getAllGlossaryTermsFromGit } from '../../lib/cms';
import AdSlot from '../../components/AdSlot.astro';

const terms = getAllGlossaryTermsFromGit().sort((a, b) => a.term.localeCompare(b.term));
---

<Base
  title="Technical Glossary & Standards Directory"
  description="Technical definitions, standards, and cryptographic specifications for client-side WebAssembly, WebCrypto, biometric passport criteria, and zero-knowledge privacy architecture."
  canonicalUrl="https://privacyfold.com/glossary/"
  pageType="glossary"
>
  <main class="wrap pg" style="padding-top: 40px; padding-bottom: 80px;">
    <div class="pg-h">
      <span class="mono eyebrow">STANDARDS &amp; TECHNICAL GLOSSARY</span>
      <h1>Privacy Engineering &amp; File Format Specifications</h1>
      <p class="pg-sub">
        Explore precise technical definitions, international regulatory standards, and architectural specifications governing client-side browser computing.
      </p>
    </div>

    <AdSlot slotKey="glossary-top" format="banner" pageType="glossary" />

    <div class="glossary-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 24px; margin-top: 32px;">
      {terms.map((item) => (
        <a href={`/glossary/${item.slug}/`} class="glossary-card" style="text-decoration: none; display: flex; flex-direction: column; background: var(--paper); border: 2px solid var(--line); border-radius: 12px; padding: 24px; box-shadow: 0 4px 0 var(--hard); transition: transform 0.1s, box-shadow 0.1s;">
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px;">
            <h2 style="font-size: 20px; font-weight: 700; color: var(--p-ink); margin: 0; line-height: 1.3;">
              {item.term}
            </h2>
            <span class="mono" style="font-size: 11px; background: #e0f2fe; color: #0369a1; padding: 2px 8px; border-radius: 99px;">
              DefinedTerm
            </span>
          </div>
          <p style="font-size: 14.5px; color: var(--p-ink-2); line-height: 1.6; flex: 1; margin: 0 0 16px 0;">
            {item.definition}
          </p>
          <span class="mono" style="font-size: 13px; font-weight: 600; color: var(--focus);">
            Read full definition &amp; specs →
          </span>
        </a>
      ))}
    </div>
  </main>
</Base>
