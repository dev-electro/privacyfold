---
import Base from '../../layouts/Base.astro';
import { getAllComparisonsFromGit } from '../../lib/cms';
import AdSlot from '../../components/AdSlot.astro';

const comparisons = getAllComparisonsFromGit();
---

<Base
  title="PrivacyFold Comparisons — Client-Side vs. Cloud Architectures"
  description="Technical comparisons evaluating PrivacyFold's browser-side WebAssembly, WebCrypto, and zero-upload models against traditional cloud processing and server-side utilities."
  canonicalUrl="https://privacyfold.com/compare/"
  pageType="blog"
>
  <main class="wrap pg" style="padding-top: 40px; padding-bottom: 80px;">
    <div class="pg-h">
      <span class="mono eyebrow">ARCHITECTURAL EVALUATION · ZERO-UPLOAD PARADIGM</span>
      <h1>PrivacyFold vs. Traditional Services</h1>
      <p class="pg-sub">
        Explore rigorous architectural, performance, and regulatory comparisons between client-side in-browser computing and conventional cloud file processors.
      </p>
    </div>

    <AdSlot slotKey="glossary-top" format="banner" pageType="blog" />

    <div class="compare-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(360px, 1fr)); gap: 24px; margin-top: 32px;">
      {comparisons.map((item) => (
        <a href={`/compare/${item.slug}/`} class="compare-card" style="text-decoration: none; display: flex; flex-direction: column; background: var(--paper); border: 2px solid var(--line); border-radius: 12px; padding: 28px; box-shadow: 0 4px 0 var(--hard); transition: transform 0.1s, box-shadow 0.1s;">
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px;">
            <span class="mono" style="font-size: 11px; background: #fef3c7; color: #92400e; padding: 2px 8px; border-radius: 99px; font-weight: 600;">
              COMPILATION &amp; AUDIT
            </span>
            <span class="mono" style="font-size: 12px; color: var(--ink-2);">
              {item.reviewed}
            </span>
          </div>
          <h2 style="font-size: 21px; font-weight: 800; color: var(--p-ink); margin: 0 0 12px 0; line-height: 1.3;">
            {item.title}
          </h2>
          <p style="font-size: 14.5px; color: var(--p-ink-2); line-height: 1.6; flex: 1; margin: 0 0 20px 0;">
            {item.summary}
          </p>
          <span class="mono" style="font-size: 13px; font-weight: 600; color: var(--focus);">
            Read architectural comparison →
          </span>
        </a>
      ))}
    </div>
  </main>
</Base>
