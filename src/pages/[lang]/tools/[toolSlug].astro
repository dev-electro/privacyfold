---
import Base from '../../../layouts/Base.astro';
import ToolDesk from '../../../components/ToolDesk.astro';
import ToolSeoArticle from '../../../components/ToolSeoArticle.astro';
import { getAllLocalizedToolsFromGit, getToolTranslations } from '../../../lib/cms';
import { generateToolJsonLdGraph } from '../../../lib/schema-generator';

export async function getStaticPaths() {
  const tools = getAllLocalizedToolsFromGit();
  return tools.map((tool) => ({
    params: { lang: tool.locale, toolSlug: tool.slug },
    props: { tool },
  }));
}

const { tool } = Astro.props;
const lang = Astro.params.lang;
const canonicalUrl = `https://privacyfold.com/${lang}/tools/${tool.slug}/`;
const defaultUrl = `https://privacyfold.com/tools/${tool.slug}/`;

const translations = getToolTranslations(tool.translation_of || tool.id);
const alternateLinks = [
  { hreflang: 'x-default', href: defaultUrl },
  { hreflang: 'en', href: defaultUrl },
  ...translations.map((tr) => ({
    hreflang: tr.locale,
    href: `https://privacyfold.com/${tr.locale}/tools/${tr.slug}/`,
  })),
];

const jsonLd = generateToolJsonLdGraph(tool, canonicalUrl);
---

<Base
  title={tool.seo.metaTitle}
  description={tool.seo.metaDescription}
  canonicalUrl={canonicalUrl}
  ogImage={`https://privacyfold.com/og/${tool.slug}.svg`}
  pageType="tool"
  alternateLinks={alternateLinks}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <ToolDesk initialToolSlug={tool.slug} />

  <div class="wrap" style="padding-bottom: 64px;">
    <ToolSeoArticle tool={tool} />
  </div>
</Base>

