        "uscis-i765-ead-photo",
        "uscis-i130-petition-photo",
        "uscis-i131-travel-document-photo",
        "us-ny-dmv-license-renewal-photo",
        "us-firearms-atf-efrom-photo",
        "uk-brp-evisa-photo",
        "uk-dvla-driving-licence-photo",
        "uk-blue-badge-photo",
        "uk-tfl-oyster-photocard",
        "uk-citb-cscs-card-photo",
        "uk-sia-security-licence-photo",
        "de-biometric-passport-35x45",
        "fr-ants-ephotos-35x45",
        "nl-pasfoto-matrix-2020",
        "es-dni-pasaporte-32x26",
        "it-passaporto-cie-35x45",
        "ie-passport-online-photo",
        "ch-swiss-pass-35x45",
        "eu-schengen-visa-photo-icao",
        "ca-ircc-pr-card-50x70",
        "ca-ircc-express-entry-visa",
        "au-immiaccount-visa-photo",
        "nz-real-me-passport-photo",
        "jp-my-number-card-photo",
        "sg-ica-passport-400x514",
        "ae-icp-golden-visa-photo",
        "sa-absher-iqama-photo",
        "in-oci-card-photo",
        "in-upsc-ssc-photo-20kb",
        "cn-chinese-visa-33x48"
