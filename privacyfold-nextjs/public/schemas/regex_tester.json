{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://privacyfold.com/schemas/regex_tester.json",
  "title": "Regex tester & explainer",
  "description": "Test regular expressions with live match counts, captured groups, and character positions.",
  "x-privacyfold-tool-id": "regex_tester",
  "x-privacyfold-category": "dev",
  "x-privacyfold-engine": "/wasm/dev/regex-tester-v1.wasm",
  "x-privacyfold-determinism-tier": "D",
  "x-privacyfold-execution-url": "https://privacyfold.com/tools/regex_tester?mode=agent&source=mcp#payload",
  "type": "object",
  "properties": {
    "preset": {
      "type": "string",
      "enum": [
        "default"
      ]
    },
    "input": {
      "type": "string",
      "description": "Input text, data URI, or local File handle via data-pf='input'"
    },
    "options": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "input"
  ]
}