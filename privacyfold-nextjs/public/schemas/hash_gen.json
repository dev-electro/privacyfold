{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://privacyfold.com/schemas/hash_gen.json",
  "title": "Hash generator",
  "description": "Create a SHA fingerprint of text or any file, to check that it has not changed.",
  "x-privacyfold-tool-id": "hash_gen",
  "x-privacyfold-category": "crypto",
  "x-privacyfold-engine": "/wasm/crypto/hash-gen-v1.wasm",
  "x-privacyfold-determinism-tier": "D",
  "x-privacyfold-execution-url": "https://privacyfold.com/tools/hash_gen?mode=agent&source=mcp#payload",
  "type": "object",
  "properties": {
    "preset": {
      "type": "string",
      "enum": [
        "default"
      ]
    },
    "input": {
      "type": "string",
      "description": "Input text, data URI, or local File handle via data-pf='input'"
    },
    "options": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "input"
  ]
}