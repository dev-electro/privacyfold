{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://privacyfold.com/schemas/image_to_pdf.json",
  "title": "Image to PDF converter",
  "description": "Place one or more photos or scanned receipts onto a standard US Letter or A4 page with clean margins for instant printing or portal upload.",
  "x-privacyfold-tool-id": "image_to_pdf",
  "x-privacyfold-category": "pdf",
  "x-privacyfold-engine": "/wasm/pdf/image-to-pdf-v1.wasm",
  "x-privacyfold-determinism-tier": "D",
  "x-privacyfold-execution-url": "https://privacyfold.com/tools/image_to_pdf?mode=agent&source=mcp#payload",
  "type": "object",
  "properties": {
    "preset": {
      "type": "string",
      "enum": [
        "default"
      ]
    },
    "input": {
      "type": "string",
      "description": "Input text, data URI, or local File handle via data-pf='input'"
    },
    "options": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "input"
  ]
}