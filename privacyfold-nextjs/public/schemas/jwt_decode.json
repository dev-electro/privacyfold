{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://privacyfold.com/schemas/jwt_decode.json",
  "title": "JWT decoder",
  "description": "Read what is inside a JSON Web Token. The signature is not checked, so do not treat a decoded token as trusted.",
  "x-privacyfold-tool-id": "jwt_decode",
  "x-privacyfold-category": "dev",
  "x-privacyfold-engine": "/wasm/dev/jwt-decode-v1.wasm",
  "x-privacyfold-determinism-tier": "D",
  "x-privacyfold-execution-url": "https://privacyfold.com/tools/jwt_decode?mode=agent&source=mcp#payload",
  "type": "object",
  "properties": {
    "preset": {
      "type": "string",
      "enum": [
        "jwt-rs256-es256-offline-audit"
      ]
    },
    "input": {
      "type": "string",
      "description": "Input text, data URI, or local File handle via data-pf='input'"
    },
    "options": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "input"
  ]
}