{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://privacyfold.com/schemas/clean_paste.json",
  "title": "Link & text cleaner",
  "description": "Paste text or links to remove tracking parameters (such as utm, fbclid and gclid), strip invisible characters, and optionally mask email addresses or secret keys.",
  "x-privacyfold-tool-id": "clean_paste",
  "x-privacyfold-category": "crypto",
  "x-privacyfold-engine": "/wasm/crypto/clean-paste-v1.wasm",
  "x-privacyfold-determinism-tier": "D",
  "x-privacyfold-execution-url": "https://privacyfold.com/tools/clean_paste?mode=agent&source=mcp#payload",
  "type": "object",
  "properties": {
    "preset": {
      "type": "string",
      "enum": [
        "default"
      ]
    },
    "input": {
      "type": "string",
      "description": "Input text, data URI, or local File handle via data-pf='input'"
    },
    "options": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "input"
  ]
}