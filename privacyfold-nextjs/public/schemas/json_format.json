{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://privacyfold.com/schemas/json_format.json",
  "title": "JSON formatter",
  "description": "Check, tidy and minify JSON. The result updates as you type.",
  "x-privacyfold-tool-id": "json_format",
  "x-privacyfold-category": "dev",
  "x-privacyfold-engine": "/wasm/dev/json-format-v1.wasm",
  "x-privacyfold-determinism-tier": "D",
  "x-privacyfold-execution-url": "https://privacyfold.com/tools/json_format?mode=agent&source=mcp#payload",
  "type": "object",
  "properties": {
    "preset": {
      "type": "string",
      "enum": [
        "stripe-webhook-json-formatter"
      ]
    },
    "input": {
      "type": "string",
      "description": "Input text, data URI, or local File handle via data-pf='input'"
    },
    "options": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "input"
  ]
}