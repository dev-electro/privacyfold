{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://privacyfold.com/schemas/svg_optimize.json",
  "title": "SVG optimizer & cleaner",
  "description": "Clean and minify SVG vector code by removing XML comments, editor metadata, empty groups, and redundant whitespace.",
  "x-privacyfold-tool-id": "svg_optimize",
  "x-privacyfold-category": "image",
  "x-privacyfold-engine": "/wasm/image/svg-optimize-v1.wasm",
  "x-privacyfold-determinism-tier": "D",
  "x-privacyfold-execution-url": "https://privacyfold.com/tools/svg_optimize?mode=agent&source=mcp#payload",
  "type": "object",
  "properties": {
    "preset": {
      "type": "string",
      "enum": [
        "svg-react-jsx-icon-optimizer"
      ]
    },
    "input": {
      "type": "string",
      "description": "Input text, data URI, or local File handle via data-pf='input'"
    },
    "options": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "input"
  ]
}