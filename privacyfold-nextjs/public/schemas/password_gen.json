{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://privacyfold.com/schemas/password_gen.json",
  "title": "Password & passphrase generator",
  "description": "Generate high-entropy random passwords or memorable multi-word XKCD passphrases using your browser\u2019s cryptographic random source.",
  "x-privacyfold-tool-id": "password_gen",
  "x-privacyfold-category": "crypto",
  "x-privacyfold-engine": "/wasm/crypto/password-gen-v1.wasm",
  "x-privacyfold-determinism-tier": "D",
  "x-privacyfold-execution-url": "https://privacyfold.com/tools/password_gen?mode=agent&source=mcp#payload",
  "type": "object",
  "properties": {
    "preset": {
      "type": "string",
      "enum": [
        "default"
      ]
    },
    "input": {
      "type": "string",
      "description": "Input text, data URI, or local File handle via data-pf='input'"
    },
    "options": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "input"
  ]
}