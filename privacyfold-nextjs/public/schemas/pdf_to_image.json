{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://privacyfold.com/schemas/pdf_to_image.json",
  "title": "PDF page to image converter",
  "description": "Rasterize document pages into high-resolution 300 DPI or 600 DPI PNG/JPEG images locally in your browser.",
  "x-privacyfold-tool-id": "pdf_to_image",
  "x-privacyfold-category": "pdf",
  "x-privacyfold-engine": "/wasm/pdf/pdf-to-image-v1.wasm",
  "x-privacyfold-determinism-tier": "D",
  "x-privacyfold-execution-url": "https://privacyfold.com/tools/pdf_to_image?mode=agent&source=mcp#payload",
  "type": "object",
  "properties": {
    "preset": {
      "type": "string",
      "enum": [
        "default"
      ]
    },
    "input": {
      "type": "string",
      "description": "Input text, data URI, or local File handle via data-pf='input'"
    },
    "options": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "input"
  ]
}