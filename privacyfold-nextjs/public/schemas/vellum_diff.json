{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://privacyfold.com/schemas/vellum_diff.json",
  "title": "Document & image compare",
  "description": "Overlay two versions of a document, contract or image to spot differences. Changed text, numbers or pixels are highlighted in red.",
  "x-privacyfold-tool-id": "vellum_diff",
  "x-privacyfold-category": "pdf",
  "x-privacyfold-engine": "/wasm/pdf/vellum-diff-v1.wasm",
  "x-privacyfold-determinism-tier": "D",
  "x-privacyfold-execution-url": "https://privacyfold.com/tools/vellum_diff?mode=agent&source=mcp#payload",
  "type": "object",
  "properties": {
    "preset": {
      "type": "string",
      "enum": [
        "default"
      ]
    },
    "input": {
      "type": "string",
      "description": "Input text, data URI, or local File handle via data-pf='input'"
    },
    "options": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "input"
  ]
}