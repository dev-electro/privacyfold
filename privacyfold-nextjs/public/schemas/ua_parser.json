{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://privacyfold.com/schemas/ua_parser.json",
  "title": "User-Agent & browser inspector",
  "description": "Inspect any User-Agent string to identify the browser family, rendering engine, operating system, and device type.",
  "x-privacyfold-tool-id": "ua_parser",
  "x-privacyfold-category": "dev",
  "x-privacyfold-engine": "/wasm/dev/ua-parser-v1.wasm",
  "x-privacyfold-determinism-tier": "D",
  "x-privacyfold-execution-url": "https://privacyfold.com/tools/ua_parser?mode=agent&source=mcp#payload",
  "type": "object",
  "properties": {
    "preset": {
      "type": "string",
      "enum": [
        "default"
      ]
    },
    "input": {
      "type": "string",
      "description": "Input text, data URI, or local File handle via data-pf='input'"
    },
    "options": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "input"
  ]
}