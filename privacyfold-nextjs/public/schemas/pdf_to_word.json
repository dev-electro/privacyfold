{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://privacyfold.com/schemas/pdf_to_word.json",
  "title": "PDF to Word converter",
  "description": "Convert PDF document pages and paragraphs into an editable Word-compatible document locally in your browser using pdf.js text extraction and RTF/DOCX structuring.",
  "x-privacyfold-tool-id": "pdf_to_word",
  "x-privacyfold-category": "pdf",
  "x-privacyfold-engine": "/wasm/pdf/pdf-to-word-v1.wasm",
  "x-privacyfold-determinism-tier": "D",
  "x-privacyfold-execution-url": "https://privacyfold.com/tools/pdf_to_word?mode=agent&source=mcp#payload",
  "type": "object",
  "properties": {
    "preset": {
      "type": "string",
      "enum": [
        "default"
      ]
    },
    "input": {
      "type": "string",
      "description": "Input text, data URI, or local File handle via data-pf='input'"
    },
    "options": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "input"
  ]
}