{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://privacyfold.com/schemas/screenshot_annotate.json",
  "title": "Screenshot annotator & callout marker",
  "description": "Add clean, high-contrast callout borders, step badges, and header captions to bug reports and documentation screenshots without uploading internal UI screens.",
  "x-privacyfold-tool-id": "screenshot_annotate",
  "x-privacyfold-category": "image",
  "x-privacyfold-engine": "/wasm/image/screenshot-annotate-v1.wasm",
  "x-privacyfold-determinism-tier": "D",
  "x-privacyfold-execution-url": "https://privacyfold.com/tools/screenshot_annotate?mode=agent&source=mcp#payload",
  "type": "object",
  "properties": {
    "preset": {
      "type": "string",
      "enum": [
        "default"
      ]
    },
    "input": {
      "type": "string",
      "description": "Input text, data URI, or local File handle via data-pf='input'"
    },
    "options": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "input"
  ]
}